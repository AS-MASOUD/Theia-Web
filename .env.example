# ==============================================================================
# Theia Web Public Frontend — Environment Template
# ==============================================================================

# Application Port & Mode
PORT=3000
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Website Backend API (Default connects to theia-web-api)
NEXT_PUBLIC_API_URL=http://localhost:8082
INTERNAL_API_URL=http://theia-web-api:8082

# Financial Dashboard Authentication & Command Center URL
# In local development: http://localhost:3000 (when running standalone)
# In production: https://app.theia-finance.ir
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
